<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Version>1.0.0</Version>
    <AssemblyName>Larik.Data.MongoDB</AssemblyName>
    <RootNamespace>Larik.Data.MongoDB</RootNamespace>
    <!-- One restore produces the assets for both release zips. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Larik.Data" Version="1.0.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
  </ItemGroup>

  <!-- The test project lives under tests/; do not compile its sources into the provider. -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

</Project>
